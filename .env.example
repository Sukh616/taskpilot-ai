# TaskPilot AI Environment Configuration

# Optional LLM API Key (OpenAI, Gemini, Anthropic, or compatible custom endpoint)
# If left blank, TaskPilot AI automatically operates in Deterministic Demo Mode.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database path (defaults to taskpilot.db)
TASKPILOT_DB_PATH=taskpilot.db
